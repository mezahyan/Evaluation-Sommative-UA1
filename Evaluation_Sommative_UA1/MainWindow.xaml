<Window x:Class="Evaluation_Sommative_UA1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Evaluation_Sommative_UA1"
        mc:Ignorable="d"
        Background="LightGray"
        Title="UA1 - Yannick Mezah F." Height="800" Width="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        
        <!-- Menu du haut -->
        <Border Grid.Row="0" Background="#102A45" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- SECTION GAUCHE : Logo et application -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="StagestiCoop" 
                       FontSize="16" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       VerticalAlignment="Center"/>
                    <TextBlock Text=" - Gestion des stages coopératifs" 
                       FontSize="14" 
                       Foreground="#A2C2E1" 
                       VerticalAlignment="Center"/>
                </StackPanel>

                <!-- SECTION DROITE : Année académique et Profil utilisateur -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Bloc Année avec icône de calendrier -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,25,0">
                        <TextBlock Text="2025-2026" 
                           FontSize="14" 
                           Foreground="White" 
                           VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Nom et Rôle de l'utilisateur -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Yannick Mezah" 
                           FontSize="14" 
                           FontWeight="SemiBold" 
                           Foreground="White"/>
                        <TextBlock Text="Etudiant" 
                           FontSize="11" 
                           Foreground="#A2C2E1"/>
                    </StackPanel>

                </StackPanel>
            </Grid>
        </Border>


        <StackPanel Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <!-- Menu de droite -->
                <StackPanel Grid.Column="0" Background="#1F4466">
                    <Grid Margin="10,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0 0 0 30">
                            <TextBlock Text="GestiCoop" FontSize="20" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Stages coopératifs" FontSize="14" FontWeight="Bold" Foreground="LightSlateGray" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" >
                            <TextBlock Text="PRINCIPAL" FontSize="12" FontWeight="Bold" Foreground="LightSlateGray" Margin="0,0,0,5" />
                            <TextBlock Text="Offres de stage" Margin="0 5" FontSize="14" Foreground="White" />
                            <TextBlock Text="Etudiants" Margin="0 5" FontSize="14" Foreground="White" />
                            <TextBlock Text="Candidatures" Margin="0 5" FontSize="14" Foreground="White" />
                            <TextBlock Text="Entreprises" Margin="0 5" FontSize="14" Foreground="White" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0 140 0 0">
                            <TextBlock Text="Yannick Mezah" FontSize="14" Foreground="White"  />
                            <TextBlock Text="Etudiant" FontSize="14" Foreground="LightSlateGray"  />
                        </StackPanel>

                    </Grid>
                </StackPanel>

                <!-- Contenu Principale -->
                <StackPanel Grid.Column="1" Margin="5" >
                    <TextBlock Text="Offres de stage" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Publier une nouvelle offre et consulter la liste des offres existantes" FontWeight="DemiBold" FontSize="12" Foreground="LightSlateGray"  />

                    <!-- FORMULAIRE -->
                    <Grid Margin="0,5" Background="White" Height="341">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,15">
                            <TextBlock Text="Nouvelle offre de stage" FontSize="18" FontWeight="Bold" Foreground="#2B5B84"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5,0">
                            <TextBlock Text="Entreprise *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5,0">
                            <TextBlock Text="Programme(s) visé(s) *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="5,0">
                            <TextBlock Text="Type de stage *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="5,5,5,15">
                            <ComboBox x:Name="CbxEntreprise" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Sélectionner une entreprise..." IsEnabled="False" Foreground="Gray"/>
                                <ComboBoxItem Content="entreprise1"/>
                                <ComboBoxItem Content="Entreprise2"/>
                                <ComboBoxItem Content="entreprise3"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="5,5,5,15">
                            <ComboBox x:Name="CbxProgramme" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Sélectionner un ou plusieurs programmes..." IsEnabled="False" Foreground="Gray"/>
                                <ComboBoxItem Content="programme1"/>
                                <ComboBoxItem Content="programme2"/>
                                <ComboBoxItem Content="programme3"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Margin="5,5,5,15">
                            <ComboBox x:Name="CbxStage" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Stage coopératif..." IsEnabled="False" Foreground="Gray"/>
                                <ComboBoxItem Content="Stage1"/>
                                <ComboBoxItem Content="Stage2"/>
                                <ComboBoxItem Content="Stage3"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="5,0">
                            <TextBlock Text="Titre du poste *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="5,0">
                            <TextBlock Text="Lieu de travail *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2" Margin="5,0">
                            <TextBlock Text="Date de début *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="3" Margin="5,0">
                            <TextBlock Text="Date de fin *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="5,5,5,15">
                            <TextBox x:Name="TxtPoste" Height="30" VerticalContentAlignment="Center" Padding="8,0,5,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="1" Margin="5,5,5,15">
                            <TextBox x:Name="TxtLieu" Height="30" VerticalContentAlignment="Center" Padding="8,0,5,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Margin="5,5,5,15">
                            <DatePicker x:Name="DtpDebut" Height="30" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="3" Margin="5,5,5,15">
                            <DatePicker x:Name="DtpFin" Height="30" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,0">
                            <TextBlock Text="Description *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="2" Margin="5,0">
                            <TextBlock Text="Nombre de poste *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="5" Grid.Column="3" Margin="5,0">
                            <TextBlock Text="Statut initial *" FontSize="12" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="5,5,5,15">
                            <TextBox x:Name="TxtDescription"
                                 Text="Décrivez les tâches, les responsabilités..."
                                 AcceptsReturn="True"             
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"
                                 Height="70"
                                 VerticalContentAlignment="Top"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="2" Margin="5,5,5,15">
                            <TextBox x:Name="TxtNombreDePoste" Height="30" VerticalContentAlignment="Center" Padding="8,0,5,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="3" Margin="5,5,5,15">
                            <ComboBox x:Name="CbxStatut" Height="30" SelectedIndex="0">
                                <ComboBoxItem Content="Sélectionner..." IsEnabled="False" Foreground="Gray"/>
                                <ComboBoxItem Content="Ouvert"/>
                                <ComboBoxItem Content="Fermé"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2">
                        </StackPanel>
                        <StackPanel Grid.Row="7" Grid.Column="2" Margin="15 0">
                            <Button  
                                Content="Initialiser" 
                                Height="35" 
                                FontWeight="Bold"
                                Background="Red" 
                                Foreground="Black"
                                IsEnabled="False" 
                                Click="BtnPublier_Effacer" />
                        </StackPanel>
                        <StackPanel Grid.Row="7" Grid.Column="3" >
                            <Button x:Name="BtnPublier" 
                                    Content="Publier" 
                                    Height="35" 
                                    FontWeight="Bold"
                                    Background="#1F4466" 
                                    Foreground="Black"
                                    IsEnabled="False" 
                                    Click="BtnPublier_Click"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="LblError" 
                       Text="La date de début ne peut pas être supérieure à la date de fin." 
                       Foreground="Red" 
                       FontWeight="Bold" 
                       Visibility="Collapsed" 
                       TextWrapping="Wrap"/>


                    <!-- Liste des od=ffres de stage -->
                    <Grid Margin="0 5" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Background="#2B5B84" BorderBrush="#CCCCCC" BorderThickness="1,1,1,1">
                            <TextBlock Text="ID" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="1" Background="#2B5B84" BorderBrush="#CCCCCC" BorderThickness="0,1,1,1">
                            <TextBlock Text="Nom" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="2" Background="#2B5B84" BorderBrush="#CCCCCC" BorderThickness="0,1,1,1">
                            <TextBlock Text="Prénom" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="3" Background="#2B5B84" BorderBrush="#CCCCCC" BorderThickness="0,1,1,1">
                            <TextBlock Text="Session" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="4" Background="#2B5B84" BorderBrush="#CCCCCC" BorderThickness="0,1,1,1">
                            <TextBlock Text="Programme" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="5" Background="#2B5B84" BorderBrush="#CCCCCC" BorderThickness="0,1,1,1">
                            <TextBlock Text="Heures" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="6" Background="#2B5B84" BorderBrush="#CCCCCC" BorderThickness="0,1,1,1">
                            <TextBlock Text="Statut" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="0" Grid.Column="7" Background="#2B5B84" BorderBrush="#CCCCCC" BorderThickness="0,1,1,1">
                            <TextBlock Text="Action" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1,0,1,1">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Dupont" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Jean" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="3" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Automne 2026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="4" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Informatique" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="5" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="420" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="6" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Approuvé" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="7" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <Button Content="Détails" Height="22" Width="70"/>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1,0,1,1">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Tremblay" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Alice" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="3" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Automne 2026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="4" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Informatique" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="5" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="420" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="6" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="En attente" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Orange"/>
                        </Border>
                        <Border Grid.Row="2" Grid.Column="7" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <Button Content="Détails" Height="22" Width="70"/>
                        </Border>

                        <Border Grid.Row="3" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1,0,1,1">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Gagnon" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Pierre" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="3" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Hiver 2027" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="4" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Réseaux" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="5" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="360" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="6" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Refusé" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Red"/>
                        </Border>
                        <Border Grid.Row="3" Grid.Column="7" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <Button Content="Détails" Height="22" Width="70"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1,0,1,1">
                            <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Roy" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Sophie" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="3" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Automne 2026" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="4" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Design" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="5" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="240" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="6" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Approuvé" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Green"/>
                        </Border>
                        <Border Grid.Row="4" Grid.Column="7" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <Button Content="Détails" Height="22" Width="70"/>
                        </Border>
                        <!-- OK-->

                        <Border Grid.Row="5" Grid.Column="0" BorderBrush="#CCCCCC" BorderThickness="1,0,1,1">
                            <TextBlock Text="5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="5" Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Côté" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="5" Grid.Column="2" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Lucas" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="5" Grid.Column="3" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Hiver 2027" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="5" Grid.Column="4" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="Informatique" Margin="5,0" VerticalAlignment="Center"/>
                        </Border>
                        <Border Grid.Row="5" Grid.Column="5" BorderBrush="#CCCCCC" BorderThickness="0,0,1,1">
                            <TextBlock Text="420" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>


                    </Grid>
                </StackPanel>

            </Grid>
        </StackPanel>
    </Grid>
</Window>
